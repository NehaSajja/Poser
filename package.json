{
  "name": "sketch-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:upper-body": "PORT=4352 VITE_HMR_PORT=4353 VITE_MHR_ENABLED=true node server/index.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/check-setup.mjs",
    "prestart": "node scripts/check-setup.mjs",
    "setup:mhr": "python3 scripts/experiments/setup-mhr.py",
    "dev:mhr": ".local/mhr-env/bin/python server/experiments/mhr_server.py",
    "test:mhr": ".local/mhr-env/bin/python tests/mhr-native.test.py",
    "test:mhr-flow": "node scripts/experiments/export-pose-targets.mjs && .local/mhr-env/bin/python tests/mhr-flow.test.py && node --test tests/poser2-mhr-flow.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "10.9.0",
    "jquery": "3.7.1",
    "jszip": "3.10.1",
    "motion": "^14.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0",
    "tldraw": "5.5.2",
    "vite": "7.2.2"
  }
}
