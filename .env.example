# Local configuration. Restart npm run dev after changing this file.
# npm run setup copies this to .env.local if it does not already exist.
# Keep real keys in .env.local, which is ignored by Git.

# Poser: sketch-to-pose search and historical reference comparisons.
GEMINI_API_KEY=

# Wireframe: required only if using Wireframe recognition.
OPENAI_API_KEY=
DECISIONS_PROVIDER=openai
DECISIONS_MODEL=gpt-6-luna

# Local app server.
PORT=4317

# Deployment only: localhost does not need a tldraw license.
# This VITE_ value is included in the browser build; do not put API secrets here.
# VITE_TLDRAW_LICENSE_KEY=
